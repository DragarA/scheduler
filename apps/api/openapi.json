          },
          "paddingBeforeMinutes": {
            "type": "number",
            "description": "Padding before in minutes"
          },
          "paddingAfterMinutes": {
            "type": "number",
            "description": "Padding after in minutes"
          },
          "priceCents": {
            "type": "number",
            "description": "Price in cents"
          },
          "currency": {
            "type": "string",
