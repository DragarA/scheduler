{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "rootDir": "../",
  "testRegex": ".*\\.spec\\.ts$",
  "moduleFileExtensions": ["js", "json", "ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "moduleResolution": "nodenext"
        }
      }
    ]
  },
  "setupFiles": ["<rootDir>/test/unit-setup.ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
