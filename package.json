{
  "name": "scheduler-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build --parallel",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prisma:generate": "cd apps/api && npx prisma generate",
    "prisma:new-migration": "cd apps/api && npx prisma migrate dev --name",
    "prisma:migrate": "cd apps/api && npx prisma migrate dev",
    "sdk:generate": "pnpm --filter @scheduler/sdk build && pnpm --filter @scheduler/sdk generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.21.0",
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.6.0"
  }
}
